<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
 <vendor>AlpinE Enaptic</vendor>
 <action id="org.auzietek.enaptic.manage">
  <description>Manage packages and software sources with Enaptic</description>
  <message>Administrator authentication is required for this Enaptic operation</message>
  <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
  <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/enaptic/enaptic-helper</annotate>
 </action>
</policyconfig>
